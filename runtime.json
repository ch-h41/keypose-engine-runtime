{
  "name": "keypose-runtime",
  "version": "1.0.0",
  "platforms": {
    "darwin-arm64": { "min_os": "14.0", "wheel_platform": "macosx_14_0_arm64" },
    "win32-x64": { "min_os": "10.0", "wheel_platform": "win_amd64" }
  },
  "python": {
    "version": "3.12.14",
    "base_url": "https://github.com/astral-sh/python-build-standalone/releases/download/20260901/",
    "darwin-arm64": {
      "install": { "file": "cpython-3.12.14+20260901-aarch64-apple-darwin-install_only.tar.gz", "sha256": "3ee3ee547cedfeb7c2b16b2b7156039f7b470bb8f857e226fd3d2eb11db83c76" },
      "full": { "file": "cpython-3.12.14+20260901-aarch64-apple-darwin-pgo+lto-full.tar.zst", "sha256": "dbefa04d4107b449e17022f9c78d3eacbd37a1aa8c166c6220dbd95addf3f318" }
    },
    "win32-x64": {
      "version": "3.12.10",
      "nuget": { "file": "python.3.12.10.nupkg", "url": "https://api.nuget.org/v3-flatcontainer/python/3.12.10/python.3.12.10.nupkg",
                 "sha256": "0eb85c2dfccccf1b17352de4c397f69194035b7d37149eacc16f1147d93de3b8" },
      "why": "python.org's own Windows build, whose python.exe and DLLs are signed by the Python Software Foundation (python-build-standalone's are unsigned). 3.12.10 is the last 3.12 python.org built for Windows."
    }
  },
  "ffmpeg": {
    "version": "7.1.5",
    "url": "https://ffmpeg.org/releases/ffmpeg-7.1.5.tar.xz",
    "sha256": "de668509caf9e35e3cd162473441fdb29538c6d96ed080292b3cf9e6fc5d558f",
    "signed_by": "FCF986EA15E6E293A5644F10B4322F04D67658D8",
    "platforms": ["darwin-arm64"]
  },
  "dav1d": {
    "version": "1.5.4",
    "url": "https://downloads.videolan.org/pub/videolan/dav1d/1.5.4/dav1d-1.5.4.tar.xz",
    "sha256": "686616b7c69eb88d44459391ab25cac13b6647a3b288835c5784e71c1514a5c5",
    "licence": "BSD-2-Clause",
    "why": "AV1 decoding in the macOS FFmpeg (FFmpeg's own AV1 decoder only drives hardware decoders); linked statically into libavcodec",
    "build_tools": { "meson": "1.12.1", "ninja": "1.13.2" },
    "platforms": ["darwin-arm64"]
  },
  "sources": [
    { "for": "FFmpeg in the macOS runtime (built by tools/ffmpeg.sh)", "file": "ffmpeg-7.1.5.tar.xz",
      "url": "https://ffmpeg.org/releases/ffmpeg-7.1.5.tar.xz", "sha256": "de668509caf9e35e3cd162473441fdb29538c6d96ed080292b3cf9e6fc5d558f" },
    { "for": "dav1d, the AV1 decoder inside the macOS FFmpeg (built by tools/ffmpeg.sh)", "file": "dav1d-1.5.4.tar.xz",
      "url": "https://downloads.videolan.org/pub/videolan/dav1d/1.5.4/dav1d-1.5.4.tar.xz", "sha256": "686616b7c69eb88d44459391ab25cac13b6647a3b288835c5784e71c1514a5c5" },
    { "for": "FFmpeg in the Windows runtime (OpenCV's opencv_videoio_ffmpeg DLL, built from tag n7.1)", "file": "ffmpeg-7.1.tar.xz",
      "url": "https://ffmpeg.org/releases/ffmpeg-7.1.tar.xz", "sha256": "40973d44970dbc83ef302b0609f2e74982be2d85916dd2ee7472d30678a7abe6" },
    { "for": "OpenCV's build scripts for that Windows DLL", "file": "opencv-videoio-ffmpeg-build-06dc20c.tar.gz",
      "github": "opencv/opencv_3rdparty", "commit": "06dc20cad65dc7fcf784f70c95d46750520889a7", "path": "ffmpeg/", "skip": "\\.dll$" }
  ],
  "omitted_dependencies": {
    "mediapipe": ["matplotlib", "sounddevice", "opencv-contrib-python"],
    "coremltools": ["pyaml"],
    "onnxruntime-directml": ["sympy", "coloredlogs"]
  }
}
